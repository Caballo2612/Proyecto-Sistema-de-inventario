rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
      get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data.rol == "Admin";
    }

    match /Usuarios/{usuario} {
      allow read: if (request.auth.uid != null && 
                      request.auth.uid == usuario) 
                      || isAdmin();

      allow create: if (request.auth.uid == usuario && 
                        request.resource.data.rol == "Usuario")
                        || isAdmin();

      allow delete: if (request.auth.uid == usuario) 
                        || isAdmin();

      allow update: if (request.auth.uid == usuario && 
                        request.resource.data.rol == resource.data.rol) 
                        || isAdmin();
    }

    match /Productos/{producto} {
      allow read: if (request.auth.uid != null);

      allow create: if isAdmin()
        && request.resource.data.nombre is string
        && request.resource.data.sku is string
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.precio is int
        && request.resource.data.precio >= 0;

      allow update: if isAdmin()
        && request.resource.data.sku == resource.data.sku;

      allow delete: if isAdmin();
    }

    match /Proveedores/{proveedor} {
      allow read: if (request.auth.uid != null);

      allow write: if isAdmin();
    }

  }
}