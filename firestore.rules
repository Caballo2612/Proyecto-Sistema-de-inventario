rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
      get(/databases/$(database)/documents/Usuarios/$(request.auth.uid)).data.rol == "Admin";
    }

    match /Usuarios/{usuario} {
      allow read: if (request.auth.uid != null && 
                      request.auth.uid == usuario) 
                      || isAdmin();

      allow create: if (request.auth.uid == usuario && 
                        request.resource.data.rol == "Usuario")
                        || isAdmin();

      allow delete: if (request.auth.uid == usuario) 
                        || isAdmin();

      allow update: if (request.auth.uid == usuario && 
                        request.resource.data.rol == resource.data.rol) 
                        || isAdmin();
    }

    match /Productos/{producto} {
      allow read: if (request.auth.uid != null);

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'nombre',
          'descripcion',
          'precio',
          'proveedor',
          'sku',
          'stock',
          'createdAt'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.descripcion is string
        && request.resource.data.sku is string
        && request.resource.data.proveedor is string
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.precio is int
        && request.resource.data.precio >= 0
        && request.resource.data.createdAt is timestamp;

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'nombre',
          'descripcion',
          'precio',
          'proveedor',
          'sku',
          'stock',
          'createdAt'
        ])
        && request.resource.data.sku == resource.data.sku
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.descripcion is string
        && request.resource.data.sku is string
        && request.resource.data.proveedor is string
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.precio is int
        && request.resource.data.precio >= 0
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }

    match /Proveedores/{proveedor} {
      allow read: if (request.auth.uid != null);

      allow write: if isAdmin();
    }

    match /System/main {
      allow read: if (request.auth.uid != null);

      allow write: if isAdmin();
    }

    match /Ventas/{venta} {
      allow read: if (request.auth.uid != null);

      allow create: if request.auth.uid != null
        && request.resource.data.keys().hasOnly([
          'items',
          'subtotal',
          'descuento',
          'iva',
          'bolsa',
          'total',
          'fecha',
          'vendedorId',
          'metodoPago'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is int
        && request.resource.data.subtotal >= 0
        && request.resource.data.descuento is int
        && request.resource.data.descuento >= 0
        && request.resource.data.iva is int
        && request.resource.data.iva >= 0
        && request.resource.data.bolsa is int
        && request.resource.data.bolsa >= 0
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.fecha is timestamp
        && request.resource.data.metodoPago is string
        && request.resource.data.vendedorId == request.auth.uid;
    }

  }
}